<script src="/i18n.js"></script>
<script>
  // L'horaires dyal Frogner kaytjebdo mn database (kaytbeddlo mn /admin)
  let hours = null;
  function renderHours() {
    if (!hours) return;
    document.getElementById('hoursList').innerHTML = [1, 2, 3, 4, 5, 6, 0].map(d => {
      const h = hours[d];
      return `<dt>${LM.day(d)}</dt><dd class="font-medium" dir="ltr">${h.closed ? LM.t('closed_word') : h.open + ' – ' + h.close}</dd>`;
    }).join('');
  }
  fetch('/api/status').then(r => r.json()).then(s => { hours = s.hours; renderHours(); });
  LM.onChange(renderHours);
  const mb = document.getElementById('menuBtn'), mn = document.getElementById('mobileNav');
  mb.addEventListener('click', () => { const open = mn.classList.toggle('hidden') === false; mb.setAttribute('aria-expanded', open); });
  mn.addEventListener('click', e => { if (e.target.closest('a')) { mn.classList.add('hidden'); mb.setAttribute('aria-expanded', 'false'); } });
</script>
